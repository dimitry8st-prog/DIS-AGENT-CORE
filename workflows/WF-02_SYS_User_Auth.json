          "id": "DIS_CORE_POSTGRES",
          "name": "DIS Core PostgreSQL"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const j = $json.result;\nif (!j || typeof j !== 'object') throw new Error('Invalid database result');\nreturn [{json:j}];\n"
      },
