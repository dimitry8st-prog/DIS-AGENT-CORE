{
  "name": "WF-03 SYS Context Manager",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "execute-workflow-trigger",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT dis_core_context($1::jsonb) AS result;",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($json)] }}"
        }
      },
      "id": "load-context",
      "name": "Load Context",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        220,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "DIS_CORE_POSTGRES",
          "name": "DIS Core PostgreSQL"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const j = $json.result;\nif (!j || typeof j !== 'object') throw new Error('Invalid database result');\nconst c = j.context;\nreturn [{json:{...j,context:{...c,state:c.expired?'expired':c.state}}}];\n"
      },
      "id": "evaluate-context",
      "name": "Evaluate Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const j = $('Execute Workflow Trigger').first().json;\nreturn [{json:{...j,error_code:'core_processing_error'}}];\n"
      },
      "id": "safe-database-error",
      "name": "Safe Database Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        220
      ]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [
        [
          {
            "node": "Load Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Load Context": {
      "main": [
        [
          {
            "node": "Evaluate Context",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Safe Database Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "none",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": false,
    "saveExecutionProgress": false,
    "executionTimeout": 60,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "active": false,
  "tags": [],
  "id": "disCoreWF03"
}
