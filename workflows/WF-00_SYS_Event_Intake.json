      "parameters": {
        "jsCode": "const j = $json;\nconst d = j.idempotency ?? {};\nlet status = 'completed';\nlet http_status = 200;\nlet message = 'Событие обработано: определён маршрут; бизнес-действия не выполнялись.';\nif (!j.valid) { status = 'invalid_event'; http_status = 400; message = 'Нужны доверенный вход, стабильный external_event_id и корректный внешний идентификатор.'; }\nelse if (j.error_code) { status = 'failed'; http_status = 503; message = 'Обработка временно недоступна.'; }\nelse if (d.rejected) { status = 'invalid_event'; http_status = 400; message = 'Отсутствует область источника.'; }\nelse if (d.duplicate) { status = 'duplicate'; message = 'Событие уже обработано.'; }\nelse if (d.busy) { status = 'busy'; http_status = 409; message = 'Событие уже обрабатывается.'; }\nelse if (d.failed) { status = 'previous_failed'; http_status = 409; message = 'Предыдущая обработка завершилась ошибкой; автоматический повтор отключён.'; }\nelse if (j.auth?.registration_required) { status = 'registration_required'; message = 'Требуется регистрация.'; }\nelse if (j.auth && !j.auth.allowed) { status = 'rejected'; http_status = 403; message = 'Доступ ограничен.'; }\nelse if (j.context?.processing_lock) { status = j.context.stale ? 'context_stale' : 'context_busy'; http_status = 409; message = 'Контекст заблокирован; обработка не продолжена.'; }\nelse if (j.context && !['active','expired'].includes(j.context.status)) { status = 'context_inactive'; http_status = 409; message = 'Контекст недоступен для обработки.'; }\nelse if (j.routing?.route === 'unknown') { message = 'Событие принято; маршрут не определён.'; }\nconst states = new Set(['new','awaiting_input','processing','awaiting_payment','awaiting_approval','completed','expired','failed']);\nconst body = {event_id:j.event_id,external_event_id:j.external_event_id,correlation_id:j.correlation_id,\n  source:j.source,channel:j.channel,project_id:j.project_id,bot_id:j.bot_id,\n  user_id:j.user_id,dialogue_id:j.dialogue_id,event_type:j.event_type,received_at:j.received_at,status,\n  duplicate:Boolean(d.duplicate),busy:Boolean(d.busy),message};\nif (j.auth) body.auth = {found:j.auth.found,registration_required:j.auth.registration_required,allowed:j.auth.allowed};\nif (j.context) body.context = {exists:j.context.exists,state:states.has(j.context.state)?j.context.state:'new',\n  expired:j.context.expired,stale:j.context.stale,processing_lock:j.context.processing_lock};\nif (j.routing) body.routing = j.routing;\nif (j.error_code) body.error = 'core_processing_error';\nreturn [{json:{http_status,body}}];\n"
