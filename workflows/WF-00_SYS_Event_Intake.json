        "jsCode": "const body = $json.body ?? $json;\nconst validObject = body && typeof body === 'object' && !Array.isArray(body);\nconst p = validObject ? body : {};\nconst ID = /^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$/;\nconst EXT = /^[A-Za-z0-9_.:-]{1,160}$/;\nconst CHANNEL = /^(telegram|api|web|webhook)$/;\n// Trusted ingress contract only. Raw Telegram/API bypass is rejected here.\nconst trusted = p.ingress?.authenticated_source === true;\nconst channel = typeof p.channel === 'string' ? p.channel : '';\nconst project_id = typeof p.project_id === 'string' ? p.project_id : '';\nconst bot_id = typeof p.bot_id === 'string' ? p.bot_id : '';\nconst source_id = typeof p.source_id === 'string' ? p.source_id : '';\nconst dialogue_id = p.dialogue_id != null ? String(p.dialogue_id) : '';\nconst external_event_id = p.external_event_id != null ? String(p.external_event_id)\n  : (p.event_id != null && !String(p.event_id).includes('|') ? String(p.event_id) : '');\nconst external = p.user_id ?? null;\nlet user_id = null;\nlet validUser = false;\nif ((typeof external === 'string' || Number.isSafeInteger(external)) && /^-?[1-9]\\d{0,18}$|^0$/.test(String(external))) {\n  try {\n    const value = BigInt(external);\n    validUser = value >= -9223372036854775808n && value <= 9223372036854775807n;\n    if (validUser) user_id = String(external);\n  } catch { validUser = false; }\n}\nconst validScope = trusted && CHANNEL.test(channel) && ID.test(project_id) && ID.test(bot_id)\n  && (source_id === '' || ID.test(source_id)) && EXT.test(external_event_id)\n  && /^[A-Za-z0-9_.:-]{1,160}$/.test(dialogue_id)\n  && !channel.includes('|') && !project_id.includes('|') && !bot_id.includes('|');\nconst source = channel === 'telegram' ? 'telegram' : (channel === 'api' || channel === 'web' ? channel : 'webhook');\nconst event_type = p.payload?.callback_data !== undefined || p.event_type === 'callback_query'\n  ? 'callback_query'\n  : (p.payload?.text !== undefined || p.event_type === 'message' ? 'message' : 'webhook');\nconst payload = (p.payload && typeof p.payload === 'object' && !Array.isArray(p.payload)) ? p.payload : {};\nreturn [{json:{\n  source, channel, project_id, bot_id, source_id, dialogue_id,\n  external_event_id, user_id, event_type, payload,\n  ingress: {authenticated_source: trusted, end_user_authenticated: false},\n  received_at:new Date().toISOString(), execution_id:String($execution.id),\n  valid: Boolean(validObject && trusted && validUser && validScope)\n}}];\n"
